{
  "name": "dsh-invest-skill",
  "version": "1.5.0",
  "type": "module",
  "description": "DeepSeek Harness bundle: the invest-skill A-share research agent preset: 15 research skills plus a pre-market/intraday/closing session-analysis scenario.",
  "license": "Apache-2.0",
  "author": {
    "name": "Warwick"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenxyzcyxpp/dsh-invest-skill.git"
  },
  "homepage": "https://github.com/chenxyzcyxpp/dsh-invest-skill#readme",
  "bugs": {
    "url": "https://github.com/chenxyzcyxpp/dsh-invest-skill/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "a-share",
    "investment-research",
    "agent-preset",
    "skills"
  ],
  "exports": {
    ".": "./index.js",
    "./provider": "./provider.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.jpg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "provider.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "docs",
    "icon.jpg",
    "LICENSE",
    "UPSTREAM_LICENSE",
    "UPSTREAM_NOTICE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
